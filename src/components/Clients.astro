<!-- Sección Clientes -->
<section id="clientes" class="section">
  <h2 class="section-title">Nuestros Clientes</h2>
  <div class="carousel-container">
    <div class="carousel">
      <div class="carousel-item">
        <img src="/images/banpro.webp" alt="Logo de la empresa Banpro">
      </div>
      <div class="carousel-item">
        <img src="/images/btg-pactual.webp" alt="Logo de la empresa BTG Pactual">
      </div>
      <div class="carousel-item">
        <img src="/images/suez.webp" alt="Logo de la empresa Suez">
      </div>
      <div class="carousel-item">
        <img src="/images/megacentro.webp" alt="Logo de la empresa Megacentro">
      </div>
    </div>
    <button class="carousel-btn prev" data-carousel-direction="-1">&#10094;</button>
    <button class="carousel-btn next" data-carousel-direction="1">&#10095;</button>
  </div>
</section>

<script>
  // Variables para el carrusel
  let currentSlide = 0;
  const items = document.querySelectorAll<HTMLElement>('.carousel-item');
  const itemCount = items.length;
  const itemsToShow = 2;

  // Inicializar carrusel
  function initCarousel() {
    for (let i = 0; i < itemCount; i++) {
      if (i < itemsToShow) {
        items[i].style.display = 'block';
      } else {
        items[i].style.display = 'none';
      }
    }
  }

  // Mover carrusel
  function moveCarousel(direction: number) {
    currentSlide = (currentSlide + direction) % (itemCount - itemsToShow + 1);
    if (currentSlide < 0) currentSlide = itemCount - itemsToShow;

    for (let i = 0; i < itemCount; i++) {
      if (i >= currentSlide && i < currentSlide + itemsToShow) {
        items[i].style.display = 'block';
      } else {
        items[i].style.display = 'none';
      }
    }
  }

  // Botones del carrusel
  document.querySelectorAll<HTMLElement>('[data-carousel-direction]').forEach((button) => {
    button.addEventListener('click', () => moveCarousel(Number(button.dataset.carouselDirection)));
  });

  // Initialize carousel
  initCarousel();
</script>

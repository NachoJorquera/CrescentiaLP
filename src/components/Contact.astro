---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
---

<!-- Sección Contacto -->
<section id="contacto" class="section">
  <h2 class="section-title">Contacto</h2>
  <div class="contacto-container">
    <form id="contacto-form">
      <div class="form-group">
        <label for="nombre">Nombre</label>
        <input type="text" id="nombre" name="nombre" required>
      </div>
      <div class="form-group">
        <label for="apellido">Apellido</label>
        <input type="text" id="apellido" name="apellido" required>
      </div>
      <div class="form-group">
        <label for="email">Correo electrónico</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="form-group">
        <label for="mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
      </div>
      <input type="text" name="website" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-appearance="interaction-only" data-language="es"></div>
      <button type="submit" class="submit-btn">Enviar mensaje</button>
    </form>
  </div>
</section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { actions } from 'astro:actions';

  interface TurnstileWindow extends Window {
    turnstile?: { reset: () => void };
  }

  const SUCCESS_MESSAGE = '¡Gracias por tu mensaje! Te contactaremos pronto.';
  const ERROR_MESSAGE = 'No pudimos enviar tu mensaje. Por favor, inténtalo de nuevo más tarde.';

  const contactForm = document.getElementById('contacto-form') as HTMLFormElement;
  const submitButton = contactForm.querySelector<HTMLButtonElement>('.submit-btn')!;

  // Returns whether the action accepted the message; a network failure counts as a rejection.
  async function sendContactForm(formData: FormData): Promise<boolean> {
    try {
      const { error } = await actions.contact(formData);
      return !error;
    } catch (requestError) {
      console.error('Contact form request failed', requestError);
      return false;
    }
  }

  // Manejar envío del formulario
  contactForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    submitButton.disabled = true;
    const sent = await sendContactForm(new FormData(contactForm));
    alert(sent ? SUCCESS_MESSAGE : ERROR_MESSAGE);
    if (sent) contactForm.reset();
    (window as TurnstileWindow).turnstile?.reset();
    submitButton.disabled = false;
  });
</script>
